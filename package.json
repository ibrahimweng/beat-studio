{
  "name": "beat-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Toolcraft ST-88 Beat Studio \u2014 a browser music workstation with a synthesised drum kit, 88-key piano, steel guitar, step sequencer and WAV/MP3/MIDI export.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource-variable/inter": "^5.3.0",
    "smplr": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
